{
  "name": "screen-saathi-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "prepare": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:snapshot": "vitest --config vitest.playwright.config.ts run tests/snapshot.playwright.test.ts --reporter=verbose",
    "test:audio": "vitest --config vitest.playwright.config.ts run tests/audio.playwright.test.ts --reporter=verbose",
    "test:watch": "vitest",
    "build": "wxt build"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  }
}
