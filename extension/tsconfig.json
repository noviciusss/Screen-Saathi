{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["chrome", "node", "vitest/globals"],
    "skipLibCheck": true,
    "allowJs": false
  },
  "include": ["env.d.ts", "src", "entrypoints", "tests", "wxt.config.ts", "vitest.config.ts"]
}
